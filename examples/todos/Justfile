set shell := ["zsh", "-cu"]

default:
    @just --list

# ── Dev ────────────────────────────────────────────────────────────────────────

dev-fe:
    cd ui && pnpm dev

dev:
    cargo run -p todos

# ── Build (release) ────────────────────────────────────────────────────────────

build:
    cd ui && pnpm build
    cargo build -p todos --release

# ── Run (release) ──────────────────────────────────────────────────────────────

run:
    cargo run -p todos --release

# ── Package ────────────────────────────────────────────────────────────────────

package: build
    cd ../.. && just package target/release/todos examples/todos/damascus.json
    @echo "Run with: shell/publish/DamascusUI --spawn target/release/todos"

# ── Check ──────────────────────────────────────────────────────────────────────

check:
    cargo check -p todos

# ── Clean ──────────────────────────────────────────────────────────────────────

clean:
    cargo clean
    rm -rf ui/dist ui/node_modules
