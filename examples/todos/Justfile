set shell := ["zsh", "-cu"]

default:
    @just --list

# ── Build ──────────────────────────────────────────────────────────────────────

build-fe:
    cd ui && pnpm build

build:
    cargo build -p todos

# ── Run ────────────────────────────────────────────────────────────────────────

run: build-fe build
    cd ../.. && just build-shell
    cargo build -p todos  # ensure fresh binary
    cd ../.. && shell/publish/DamascusUI --spawn target/debug/todos

# ── Dev ────────────────────────────────────────────────────────────────────────

dev-fe:
    cd ui && pnpm dev

dev:
    cargo run -p todos

check:
    cargo check -p todos

clean:
    cargo clean
    rm -rf ui/dist ui/node_modules
