set shell := ["zsh", "-cu"]

default:
    @just --list

# ── Build ──────────────────────────────────────────────────────────────────────

# Build frontend
build-fe:
    cd frontend && pnpm build

# Build everything (frontend → viewer → backend)
build: build-fe
    cd ../.. && just build-viewer
    cargo build -p todos-backend

# ── Run ────────────────────────────────────────────────────────────────────────

# Build and run the packaged app
run: build
    cargo run -p todos-backend

# Run without rebuilding
run-fast:
    cargo run -p todos-backend

# ── Dev ────────────────────────────────────────────────────────────────────────

# Start backend (API + embedded frontend, auto-launches viewer)
dev:
    cargo run -p todos-backend

# Start frontend dev server only (Vite HMR at :5173)
dev-fe:
    cd frontend && pnpm dev

# ── Check ──────────────────────────────────────────────────────────────────────

check:
    cargo check -p todos-backend

# ── Clean ──────────────────────────────────────────────────────────────────────

clean:
    cargo clean

clean-fe:
    rm -rf frontend/dist frontend/node_modules
