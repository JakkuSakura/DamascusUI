set shell := ["zsh", "-cu"]

default:
    @just --list

# ── Dev ────────────────────────────────────────────────────────────────────────

dev-fe:
    cd ui && pnpm dev

dev:
    cargo run -p todos

# ── Build (release) ────────────────────────────────────────────────────────────

build:
    cd ui && pnpm build
    cargo build -p todos --release

# ── Run (release) ──────────────────────────────────────────────────────────────

run: build
    cp ui/public/favicon.ico ../../shell/favicon.ico
    cd ../.. && just build-shell examples/todos/damascus.json
    cd ../.. && shell/publish/DamascusUI.app/Contents/MacOS/DamascusUI --spawn "$(pwd)/target/release/todos"

run-core:
    cargo run -p todos --release

# ── Package ────────────────────────────────────────────────────────────────────

package: build
    cp ui/public/favicon.ico ../../shell/favicon.ico
    cd ../.. && just package target/release/todos examples/todos/damascus.json

check:
    cargo check -p todos

clean:
    cargo clean
    rm -rf ui/dist ui/node_modules
